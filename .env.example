# Application runtime URL. Never commit a real value.
DATABASE_URL=

# Migration-owner URL. Keep separate from DATABASE_URL and never commit a real value.
DATABASE_MIGRATION_URL=

# Development/test only. Keep false in shared examples and never set this in production.
ENABLE_SYNTHETIC_BOOTSTRAP=false

# Optional future integrations; keep unset during Phase 01.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
RESEND_API_KEY=
AI_GATEWAY_API_KEY=
