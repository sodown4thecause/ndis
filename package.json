{
  "name": "attesta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @attesta/web dev",
    "build": "pnpm --filter @attesta/web build",
    "lint": "pnpm --filter @attesta/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm vitest run",
    "test:e2e": "playwright test",
    "db:check": "pnpm --filter @attesta/db db:check",
    "test:db": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
