{
  "name": "attesta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @attesta/web dev",
    "build": "pnpm --filter @attesta/web build",
    "lint": "pnpm --filter @attesta/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm vitest run",
    "test:e2e": "playwright test",
    "db:check": "pnpm --filter @attesta/db db:check",
    "test:db": "pnpm --filter @attesta/db test:db"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
